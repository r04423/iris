{
  "name": "iris-ecs",
  "version": "0.0.13",
  "type": "module",
  "description": "Entity Component System implementation for TypeScript",
  "author": "Yury Tomilin (https://github.com/r04423)",
  "homepage": "https://github.com/r04423/iris#readme",
  "bugs": "https://github.com/r04423/iris/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test:coverage": "c8 tsx --test 'src/**/*.test.ts'",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\"",
    "build": "pnpm --filter @iris/tooling build:prune iris-ecs",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "compile": "pnpm --filter @iris/tooling build:clean iris-ecs && tsdown && pnpm --filter @iris/tooling build:record iris-ecs"
  },
  "keywords": [
    "ecs",
    "entity-component-system",
    "game",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/r04423/iris.git",
    "directory": "packages/ecs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/node": "^24.0.0",
    "c8": "^12.0.0",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.0-beta"
  }
}
