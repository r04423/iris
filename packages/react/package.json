{
  "name": "iris-react",
  "version": "0.0.11",
  "type": "module",
  "description": "React bindings for Iris ECS",
  "author": "Yury Tomilin (https://github.com/r04423)",
  "homepage": "https://github.com/r04423/iris#readme",
  "bugs": "https://github.com/r04423/iris/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/r04423/iris.git",
    "directory": "packages/react"
  },
  "keywords": [
    "ecs",
    "react",
    "hooks",
    "entity-component-system",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test --import global-jsdom/register 'src/**/*.test.tsx'",
    "test:coverage": "c8 tsx --test --import global-jsdom/register 'src/**/*.test.tsx'",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "iris-ecs": "workspace:*",
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "c8": "^10.1.3",
    "global-jsdom": "^26.0.0",
    "iris-ecs": "workspace:*",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.0-beta"
  }
}
